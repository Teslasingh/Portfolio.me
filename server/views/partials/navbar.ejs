<!--
File name: navbar.ejs
Author's name: Anubhav Kumar Singh
file description: Fixed site navigation. The active link is picked from the page title passed by the router.
-->
<%
  var t = (typeof title !== 'undefined' && title) ? title : '';
  var current = { 'Anubhav Kumar Singh': '/', 'ABOUT ME': '/about', 'PORTFOLIO': '/portfolio', 'collaboration': '/collaboration', 'CONTACT ME': '/contact' }[t] || '';
  var links = [['/', 'Home'], ['/about', 'About'], ['/portfolio', 'Portfolio'], ['/collaboration', 'Collaboration'], ['/contact', 'Contact']];
%>
<header class="site-header">
    <a class="mark" href="/"><i></i>Anubhav<span>Kumar Singh</span></a>
    <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="siteNav">Menu</button>
    <nav class="site-nav" id="siteNav" aria-label="Pages">
        <% links.forEach(function (l) { %>
            <a href="<%= l[0] %>"<% if (l[0] === current) { %> class="on" aria-current="page"<% } %>><%= l[1] %></a>
        <% }); %>
    </nav>
</header>
<ul class="index" id="sectionIndex" aria-label="Sections on this page"></ul>
