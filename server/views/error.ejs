<!-- File name: error.ejs
     Author's name: Anubhav Kumar Singh
     file description: Error page rendered by the Express error handler. Styled like the rest of the site;
     the stack trace only appears in development.
-->
<% include partials/header %>
<% include partials/navbar %>

<main>
    <section id="error" class="panel-section" data-shape="nested" data-label="Error">
        <div class="wrap"><div class="col">
            <div class="eyebrow">Something went wrong</div>
            <div class="error-code"><%= (typeof error !== 'undefined' && error && error.status) ? error.status : 'Oops' %></div>
            <h2><%= (typeof message !== 'undefined' && message) ? message : 'Page not found' %></h2>
            <p>The page you were looking for isn't here. Try one of these instead.</p>
            <div class="cta"><a class="btn primary" href="/">Go home</a><a class="btn" href="/portfolio">See projects</a></div>
            <% if (typeof error !== 'undefined' && error && error.stack) { %><pre class="glass stack"><%= error.stack %></pre><% } %>
        </div></div>
    </section>
</main>

<% include partials/footer %>
